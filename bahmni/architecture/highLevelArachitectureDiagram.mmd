flowchart TD                                                                                                                                                                                     
      classDef user fill:#ECF0F1,stroke:#95A5A6,color:#2C3E50                                                                                                                                      
      classDef frontend fill:#2980B9,stroke:#1A5276,color:#fff                                                                                                                                     
      classDef emr fill:#1E8449,stroke:#145A32,color:#fff                                                                                                                                          
      classDef lab fill:#CA6F1E,stroke:#935116,color:#fff                                                                                                                                        
      classDef erp fill:#7D3C98,stroke:#5B2C6F,color:#fff                                                                                                                                          
      classDef pacs fill:#117A65,stroke:#0E6655,color:#fff                                                                                                                                         
      classDef cdss fill:#B7950B,stroke:#9A7D0A,color:#fff
      classDef sms fill:#CB4335,stroke:#922B21,color:#fff
      classDef analytics fill:#1A252F,stroke:#0D1B2A,color:#fff
      classDef monitoring fill:#616A6B,stroke:#424949,color:#fff

      User(["Clinician / Staff"]):::user

      subgraph FRONTEND["  Frontend  "]
          BahmniWeb["Bahmni Web"]:::frontend
      end

      subgraph CORE["  Core EMR  "]
          OpenMRS["OpenMRS"]:::emr
      end

      subgraph LAB_LAYER["  Lab  "]
          OpenELIS["OpenELIS\nLab System"]:::lab
      end

      subgraph ERP_LAYER["  ERP / Billing  "]
          OdooConnect["Odoo Connect\nIntegration Middleware"]:::erp
          Odoo["Odoo\nERP & Billing"]:::erp
      end

      subgraph PACS_LAYER["  Radiology / PACS  "]
          PACSInteg["PACS Integration"]:::pacs
          DCM4CHEE["DCM4CHEE\nImaging Server"]:::pacs
      end

      subgraph CDS_LAYER["  Clinical Decision Support  "]
          CDSS["CDSS"]:::cdss
          Snowstorm["Snowstorm Lite\nSNOMED-CT"]:::cdss
      end

      subgraph ANALYTICS_LAYER["  Reporting & Analytics  "]
          Reports["Reports &\nAnalytics\nMetabase"]:::analytics
      end

      SMS["SMS Service"]:::sms
      AtomfeedConsole["Atomfeed Console\nEvent Monitoring"]:::monitoring

      RadDevice(["Radiology Device"]):::user
      Patient(["Patient Phone"]):::user

      User --> BahmniWeb

      BahmniWeb -->|"REST / FHIR"| OpenMRS

      OpenMRS <-->|"Atomfeed"| OpenELIS

      OpenMRS -->|"Atomfeed"| OdooConnect
      OdooConnect <-->|"REST"| Odoo

      OpenMRS -->|"Atomfeed"| PACSInteg
      PACSInteg -->|"DICOM"| DCM4CHEE
      DCM4CHEE <-->|"DICOM"| RadDevice

      OpenMRS -->|"FHIR"| CDSS
      CDSS -->|"FHIR"| Snowstorm

      OpenMRS -->|"REST"| SMS
      SMS --> Patient

      OpenMRS -->|"Direct DB"| Reports
      OpenELIS -->|"Direct DB"| Reports
      Odoo -->|"Direct DB"| Reports

      AtomfeedConsole -. "monitors" .-> OpenMRS
      AtomfeedConsole -. "monitors" .-> OpenELIS
      AtomfeedConsole -. "monitors" .-> Odoo
      AtomfeedConsole -. "monitors" .-> PACSInteg

      style FRONTEND fill:#D6EAF8,stroke:#2980B9
      style CORE fill:#D5F5E3,stroke:#1E8449
      style LAB_LAYER fill:#FDEBD0,stroke:#CA6F1E
      style ERP_LAYER fill:#E8DAEF,stroke:#7D3C98
      style PACS_LAYER fill:#D1F2EB,stroke:#117A65
      style CDS_LAYER fill:#FEF9E7,stroke:#B7950B
      style ANALYTICS_LAYER fill:#D5D8DC,stroke:#1A252F